# Copie para .env e preencha os segredos com valores aleatórios longos, por exemplo:
#   openssl rand -base64 48
POSTGRES_DB=remotewake
POSTGRES_USER=remotewake
POSTGRES_PASSWORD=

# Gateway residencial (docs/REMOTE_SETUP.md).
GATEWAY_KEY=
GATEWAY_OWNER_EMAIL=
GATEWAY_ALLOWED_BROADCASTS=
# URL pública (HTTPS) ou da tailnet quando o gateway roda em outro equipamento.
REMOTE_WAKE_API_URL=http://127.0.0.1:8080/

# Chave-mestra da qual derivam as chaves dos agentes.
AGENT_MASTER_KEY=

# Primeira conta: sem SETUP_TOKEN, a API exibe um código no log (docker compose logs api).
SETUP_TOKEN=
ALLOW_REGISTRATION=false

# Opcional: portas locais e nome do projeto (para rodar mais de uma instância na mesma máquina).
# WEB_PORT=8005
# API_PORT=8080
# COMPOSE_PROJECT_NAME=remote-wake
# ASPNETCORE_ENVIRONMENT=Production

# Produção com HTTPS (compose.prod.yaml e docs/DEPLOY.md).
# DOMAIN=remotewake.seudominio.com
# HTTP_PORT=80
# HTTPS_PORT=443

# Demonstração sem hardware (docker compose --profile demo up -d): ID e chave do agente
# da máquina de teste, copiados do painel.
# DEMO_AGENT_MACHINE_ID=
# DEMO_AGENT_KEY=
